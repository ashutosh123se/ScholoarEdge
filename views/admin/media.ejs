<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="admin-container">
  <%- include('../partials/admin-sidebar') %>

  <main class="admin-content">
    <div class="content-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h1>Media Library</h1>
        <div class="content-header-meta">Upload images and manage all site media. Click any image to copy its URL.</div>
      </div>
      <button type="button" class="btn btn-primary" onclick="document.getElementById('upload-trigger').click()">
        <i class="fa-solid fa-upload"></i> Upload Image
      </button>
    </div>

    <%- include('../partials/flash') %>

    <!-- Quick Upload Form (hidden file input triggered by button) -->
    <form id="quick-upload-form" action="/admin/media/upload" method="POST" enctype="multipart/form-data" style="display: none;">
      <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
      <input type="file" id="upload-trigger" name="media_file" accept="image/*" multiple>
    </form>

    <!-- Drag & Drop Zone -->
    <div id="drop-zone" style="border: 2px dashed var(--border); border-radius: var(--radius-lg); padding: 2.5rem; text-align: center; margin-bottom: 2rem; background: var(--cream); transition: all 0.2s; cursor: pointer;">
      <i class="fa-solid fa-cloud-arrow-up" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 0.75rem;"></i>
      <p style="font-weight: 600; color: var(--text-dark); margin-bottom: 0.25rem;">Drag &amp; drop images here</p>
      <p style="font-size: 0.8rem; color: var(--text-muted);">or click the Upload Image button above &mdash; JPEG, PNG, WEBP, GIF, max 5MB</p>
    </div>

    <!-- Media Grid -->
    <% if (files.length === 0) { %>
    <div class="dashboard-table-card" style="padding: 4rem; text-align: center; color: var(--text-muted);">
      <i class="fa-solid fa-images" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.2;"></i>
      <p>No images in the media library yet. Upload your first image!</p>
    </div>
    <% } else { %>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
      <% files.forEach(file => { %>
      <div class="media-card" style="background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; position: relative; group;">

        <!-- Image Preview -->
        <div style="position: relative; aspect-ratio: 16/10; background: var(--cream);">
          <img src="<%= file.url %>" alt="<%= file.alt_text || file.original_name %>"
               style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;"
               onclick="copyUrl('<%= file.url %>', this)"
               title="Click to copy URL">
          <div style="position: absolute; inset: 0; background: rgba(13,27,42,0); transition: 0.2s; display: flex; align-items: center; justify-content: center; opacity: 0;"
               class="media-overlay" onmouseover="this.style.background='rgba(13,27,42,0.6)'; this.style.opacity=1;"
               onmouseout="this.style.background='rgba(13,27,42,0)'; this.style.opacity=0;">
            <span style="color: white; font-size: 0.8rem; font-weight: 600;"><i class="fa-solid fa-copy"></i> Copy URL</span>
          </div>
        </div>

        <!-- Info -->
        <div style="padding: 0.75rem;">
          <div style="font-size: 0.75rem; font-weight: 600; color: var(--text-dark); margin-bottom: 0.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= file.original_name %>">
            <%= file.original_name %>
          </div>
          <div style="font-size: 0.65rem; color: var(--text-muted); margin-bottom: 0.5rem;">
            <%= (file.size_bytes / 1024).toFixed(1) %> KB &middot; <%= new Date(file.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
            <% if (file.uploader) { %>&middot; <%= file.uploader %><% } %>
          </div>

          <!-- Alt text -->
          <div style="font-size: 0.7rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 0.6rem;" title="Alt: <%= file.alt_text || 'None' %>">
            Alt: <em><%= file.alt_text || '(none)' %></em>
          </div>

          <!-- Actions -->
          <div style="display: flex; gap: 0.4rem;">
            <button type="button" class="btn btn-ghost" style="font-size: 0.7rem; padding: 0.3rem 0.5rem; border-color: var(--border); flex: 1;"
                    onclick="copyUrl('<%= file.url %>', this)">
              <i class="fa-solid fa-copy"></i> Copy
            </button>
            <form action="/admin/media/<%= file.id %>/delete" method="POST" class="confirm-delete-form" data-item-name="<%= file.original_name %>">
              <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
              <button type="submit" class="btn" style="font-size: 0.7rem; padding: 0.3rem 0.5rem; background: rgba(220,38,38,0.08); color: var(--error); border: 1px solid rgba(220,38,38,0.2);">
                <i class="fa-solid fa-trash"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 2rem;">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="/admin/media?page=<%= i %>" class="btn btn-ghost" style="padding: 0.4rem 0.85rem; font-size: 0.85rem; <%= i === currentPage ? 'background: var(--navy); color: var(--gold); border-color: var(--navy);' : 'border-color: var(--border);' %>"><%= i %></a>
      <% } %>
    </div>
    <% } %>
    <% } %>
  </main>
</div>

<!-- Copy Success Toast -->
<div id="copy-toast" style="display: none; position: fixed; bottom: 2rem; right: 2rem; background: var(--navy); color: var(--cream); padding: 0.75rem 1.5rem; border-radius: var(--radius); font-size: 0.875rem; z-index: 9999; box-shadow: var(--shadow-md);">
  <i class="fa-solid fa-check"></i> URL copied to clipboard!
</div>

<!-- Delete Confirmation Modal -->
<div id="delete-modal-overlay" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: var(--white); border-radius: var(--radius-lg); padding: 2rem; max-width: 400px; width: 90%;">
    <h3 style="color: var(--error); margin-bottom: 0.5rem;">Delete File</h3>
    <p style="color: var(--text-mid); margin-bottom: 1.5rem;">Permanently delete "<span id="modal-item-name"></span>"? This cannot be undone.</p>
    <div style="display: flex; gap: 1rem; justify-content: flex-end;">
      <button id="modal-cancel-btn" class="btn btn-ghost">Cancel</button>
      <button id="modal-confirm-delete-btn" class="btn" style="background: var(--error); color: white;">Delete</button>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
// Auto-submit on file select
document.getElementById('upload-trigger').addEventListener('change', (e) => {
  if (e.target.files.length > 0) document.getElementById('quick-upload-form').submit();
});

// Drag & drop on zone
const dropZone = document.getElementById('drop-zone');
dropZone.addEventListener('click', () => document.getElementById('upload-trigger').click());
dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.style.borderColor = 'var(--navy)'; dropZone.style.background = 'rgba(13,27,42,0.04)'; });
dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = 'var(--border)'; dropZone.style.background = 'var(--cream)'; });
dropZone.addEventListener('drop', (e) => {
  e.preventDefault();
  dropZone.style.borderColor = 'var(--border)'; dropZone.style.background = 'var(--cream)';
  const file = e.dataTransfer.files[0];
  if (file) {
    const dt = new DataTransfer();
    dt.items.add(file);
    document.getElementById('upload-trigger').files = dt.files;
    document.getElementById('quick-upload-form').submit();
  }
});

// Copy URL to clipboard
function copyUrl(url, el) {
  navigator.clipboard.writeText(window.location.origin + url).then(() => {
    const toast = document.getElementById('copy-toast');
    toast.style.display = 'block';
    setTimeout(() => toast.style.display = 'none', 2000);
    if (el.tagName === 'BUTTON') { const orig = el.innerHTML; el.innerHTML = '<i class="fa-solid fa-check"></i> Copied!'; setTimeout(() => el.innerHTML = orig, 2000); }
  });
}
</script>
